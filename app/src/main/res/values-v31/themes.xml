<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Android 12 draws its own launch screen instead of using windowBackground, so the colour has
      to be restated here or the app opens on a white flash before the first frame.
    -->
    <style name="Theme.PokerTracker" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface_base</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/surface_base</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
